    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@wordpress/babel-preset-default": "^8.53.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
